DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# SMS (Africa's Talking). Leave empty to log messages without sending.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
AT_SANDBOX=true
# Public URL of the deployed app (receipt links in SMS, phone photo links)
NEXT_PUBLIC_APP_URL=
# Random string; Vercel Cron sends it to /api/cron/daily-summary
CRON_SECRET=
